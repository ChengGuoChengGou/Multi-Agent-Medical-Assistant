# ===========================================
# Multi-Agent Medical Assistant - Environment Variables
# Copy this file to .env and fill in your values
# ===========================================

# --- LLM Configuration ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
# embedding_openai_api_key=  # optional: separate key for embeddings

# --- Vector Database (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # optional if Qdrant has no auth

# --- Memory (Mem0) ---
MEM0_API_KEY=  # optional: for cloud Mem0
MEM0_HOST=     # optional: Mem0 cloud host

# --- Observability (Langfuse) ---
LANGFUSE_PUBLIC_KEY=  # optional: for Langfuse tracing

# --- API Keys for Medical Tools ---
TAVILY_API_KEY=       # Tavily search API
S2_API_KEY=           # Semantic Scholar API
OMIM_API_KEY=         # OMIM genetic database API
HUGGINGFACE_TOKEN=    # for gated models (e.g., BioMistral)
ELEVEN_LABS_API_KEY=  # optional: for TTS

# --- MCP Integration ---
BIOMCP_BIN=           # path to BioMCP binary (optional)
MCP_TEST_CMD=         # MCP test command (optional)

# --- Model Configuration ---
BRAIN_TUMOR_MODEL_GDRIVE_ID=  # Google Drive ID for brain tumor model

# --- Gunicorn SSL (Production) ---
GUNICORN_CERTFILE=    # path to SSL cert (optional)
GUNICORN_KEYFILE=     # path to SSL key (optional)

# --- Evaluation ---
RUN_FULL_EVAL=false   # set to 'true' to run full evaluation suite
