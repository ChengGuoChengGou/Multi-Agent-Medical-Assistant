# 医疗助手 - 环境配置示例
# 复制此文件为 .env 并填写实际值

# ===== 核心配置 =====
# API 服务端口
PORT=8000
# 生产环境请设为 False
DEBUG=true

# ===== LLM Provider =====
# 支持: xiaomi-mimo, openai, anthropic, deepseek, qwen, moonshot
PROVIDER=xiaomi-mimo

# 主模型配置
openai_api_key=your-api-key-here
OPENAI_BASE_URL=https://api.xiaomimimo.com/v1
model_name=mimo-v2-pro
embedding_model_name=text-embedding-3-large

# 备用模型链（可选，逗号分隔）
FALLBACK_MODELS=openai,anthropic,deepseek

# ===== RAG 配置 =====
# Qdrant 向量数据库
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=medical_docs
QDRANT_API_KEY=your-qdrant-key

# ===== 记忆系统 =====
# Mem0 记忆存储
MEM0_API_KEY=your-mem0-key

# ===== 安全 =====
# CORS 允许的源
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]
# API 密钥轮换
ROTATE_API_KEYS=false

# ===== 工具集成 =====
# Web 搜索
SEARCH_API_KEY=your-search-key
# 语音识别
SPEECH_API_KEY=your-speech-key

# ===== 监控 =====
# Prometheus 指标端点
METRICS_ENABLED=true
# 日志级别
LOG_LEVEL=INFO
