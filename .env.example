# === Multi-Agent Medical Assistant - Environment Variables ===

# --- Core LLM ---
# Used by the router and conversation agent
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Medical Vision Model (for image classification) ---
# Uses same OPENAI key by default

# --- Phase 1: Observability (Langfuse) - Optional ---
# Get your keys at https://langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Phase 1: Long-term Memory (Mem0) - Optional ---
# Uses OpenAI embeddings by default, or specify custom
MEM0_API_KEY=
MEM0_HOST=

# --- MCP Integration ---
MCP_ENABLED=true
# BioMCP, autoicd-mcp, Healthcare MCP are configured in agents/mcp_client.py

# --- Speech ---
ELEVENLABS_API_KEY=

# --- Web Search ---
TAVILY_API_KEY=

# --- Deployment ---
# Set to 'production' to disable debug mode
ENVIRONMENT=development
